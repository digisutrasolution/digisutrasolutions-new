generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  DEVELOPER
  TESTER
  SEO_MANAGER
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(DEVELOPER)
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  /// Team-member profile. Every field optional — the app must keep working
  /// for an account that has filled in nothing but a name and an email.
  photoUrl      String?
  mobile        String?
  whatsapp      String?
  telegram      String?
  /// Microsoft Teams handle or the deep-link id used to start a chat.
  teamsId       String?
  address       String?
  city          String?
  state         String?
  country       String?
  /// PIN / ZIP — kept as text: leading zeros are real in many countries.
  postalCode    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]
  auditLogs     AuditLog[]
  pagesCreated  Page[]         @relation("PageCreatedBy")
  pagesUpdated  Page[]         @relation("PageUpdatedBy")
  pushSubs      PushSubscription[]
  assignedLeads Lead[]         @relation("LeadAssignee")
  followUps     FollowUp[]     @relation("FollowUpOwner")
  promosCreated  Promotion[]      @relation("PromotionAuthor")
  promosApproved Promotion[]      @relation("PromotionApprover")
  codesRedeemed  PromotionClaim[] @relation("ClaimRedeemer")
  /** Optional custom role — when set, its permission set overrides the enum
      role's (except Super Admin, who is always all-powerful). */
  customRole    CustomRole?    @relation("UserCustomRole", fields: [customRoleId], references: [id], onDelete: SetNull)
  customRoleId  String?
}

/* An admin-defined role: a named permission set assigned to users on top of
   the fixed enum roles. Super Admin is never a custom role. */
model CustomRole {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]   @relation("UserCustomRole")
}

model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  ua        String?
  createdAt DateTime @default(now())

  @@index([userId])
}

/* What a Page IS, as opposed to where it is in its lifecycle (PageStatus).
   TEMPLATE is not a separate model on purpose: a template is a page you clone,
   so it reuses the whole editor, versioning and section pipeline. Templates
   never render publicly. */
enum PageKind {
  PAGE
  LANDING
  TEMPLATE
}

enum PageStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum WorkflowStage {
  DRAFT
  TESTING
  SEO_REVIEW
  APPROVAL
  APPROVED
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugStatus {
  OPEN
  RESOLVED
  WONT_FIX
}

model Page {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  kind           PageKind      @default(PAGE)
  /// A/B testing. A variant is a full Page pointing at its control; the
  /// control has variantOfId null. Variants render at the CONTROL url, so
  /// they are never a second indexable address for the same offer.
  variantOf      Page?         @relation("PageVariants", fields: [variantOfId], references: [id], onDelete: Cascade)
  variantOfId    String?
  variants       Page[]        @relation("PageVariants")
  /// Relative share of traffic against its siblings AND the control.
  variantWeight  Int           @default(50)
  status         PageStatus    @default(DRAFT)
  sections       Json          @default("[]")
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  ogImage        String?
  noIndex        Boolean       @default(false)
  schemaJson     Json?
  publishedAt    DateTime?
  scheduledAt    DateTime?
  createdBy      User?         @relation("PageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById    String?
  updatedBy      User?         @relation("PageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  workflowStage  WorkflowStage @default(DRAFT)
  versions       PageVersion[]
  leads          Lead[]        @relation("LeadLandingPage")
  pageViews      PageView[]
  transitions    WorkflowTransition[]
  comments       PageComment[]
  bugs           BugReport[]

  @@index([kind, status])
  @@index([variantOfId])
  @@index([status, publishedAt])
  @@index([workflowStage])
}

model WorkflowTransition {
  id        String        @id @default(cuid())
  page      Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId    String
  from      WorkflowStage
  to        WorkflowStage
  note      String?
  byId      String?
  byName    String?
  createdAt DateTime      @default(now())

  @@index([pageId, createdAt])
}

model PageComment {
  id          String        @id @default(cuid())
  page        Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId      String
  body        String
  stageAtTime WorkflowStage
  authorId    String?
  authorName  String?
  createdAt   DateTime      @default(now())

  @@index([pageId, createdAt])
}

model BugReport {
  id             String      @id @default(cuid())
  page           Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId         String
  title          String
  description    String
  severity       BugSeverity @default(MEDIUM)
  status         BugStatus   @default(OPEN)
  screenshotUrl  String?
  reportedById   String?
  reportedByName String?
  resolvedById   String?
  resolvedByName String?
  resolvedAt     DateTime?
  createdAt      DateTime    @default(now())

  @@index([pageId, status])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model MediaAsset {
  id             String   @id @default(cuid())
  filename       String   @unique
  originalName   String
  mimeType       String
  size           Int
  width          Int?
  height         Int?
  alt            String   @default("")
  url            String
  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model BlogPost {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  excerpt        String     @default("")
  body           String     @default("")
  category       String     @default("General")
  tags           String[]   @default([])
  coverUrl       String?
  status         PageStatus @default(DRAFT)
  publishedAt    DateTime?
  scheduledAt    DateTime?
  readingMinutes Int        @default(1)
  seoTitle       String?
  seoDescription String?
  noIndex        Boolean    @default(false)
  authorId       String?
  authorName     String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  comments       BlogComment[]

  @@index([status, publishedAt])
  @@index([category])
}

model Form {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  fields      Json             @default("[]")
  notifyEmail String?
  isActive    Boolean          @default(true)
  /** Where a submission goes: "submission" = stored only; "lead" = also
      creates a Lead so admin-built forms feed the leads pipeline. */
  destination String           @default("submission")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  submissions FormSubmission[]
}

model FormSubmission {
  id        String   @id @default(cuid())
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    String
  data      Json
  ip        String?
  createdAt DateTime @default(now())

  @@index([formId, createdAt])
}

enum VideoProvider {
  YOUTUBE
  VIMEO
  FILE
}

model Video {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  provider       VideoProvider
  videoId        String
  description    String        @default("")
  category       String        @default("General")
  thumbnailUrl   String?
  durationSec    Int?
  featured       Boolean       @default(false)
  uploadedByName String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([featured])
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  permanent Boolean  @default(false)
  isActive  Boolean  @default(true)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
}

/* On-site search terms typed into the /search box. Normalized (lowercased,
   trimmed) for grouping; `results` lets the admin spot content gaps (0-result
   searches). No visitor identifier stored. */
model SearchQuery {
  id        String   @id @default(cuid())
  query     String
  results   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([query])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  /// Which Page actually rendered. Needed because an A/B variant is served
  /// at its control's path — without this every variant's views would be
  /// counted against the control and the test could not be read.
  page      Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)
  pageId    String?
  referrer  String?
  createdAt DateTime @default(now())
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String?

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([pageId, createdAt])
  @@index([sessionId])
}

/* A visitor session — pageviews grouped by an ephemeral sessionStorage key
   (no cookie, cleared when the tab closes, so no persistent visitor tracking).
   Device/OS/browser are parsed from the UA and country from the CF edge
   header; the IP is only ever stored hashed. */
model Session {
  id          String     @id @default(cuid())
  key         String     @unique
  startedAt   DateTime   @default(now())
  lastSeenAt  DateTime   @default(now())
  pageCount   Int        @default(1)
  landingPath String
  exitPath    String
  referrer    String?
  device      String?
  browser     String?
  os          String?
  country     String?
  ipHash      String?
  views       PageView[]

  @@index([startedAt])
  @@index([country])
  @@index([device])
}

model AiGeneration {
  id          String   @id @default(cuid())
  userId      String?
  userName    String?
  kind        String
  model       String
  inputChars  Int
  outputChars Int
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model PageVersion {
  id            String   @id @default(cuid())
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId        String
  version       Int
  title         String
  sections      Json
  seoSnapshot   Json
  note          String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@unique([pageId, version])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Single-use password-reset ticket. Only the SHA-256 of the token is kept,
/// so a database leak cannot be replayed to take over accounts — the same
/// reasoning as RefreshToken above.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
  @@index([userId, createdAt])
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

enum AdPlacement {
  BLOG_SIDEBAR
  ARTICLE_SIDEBAR
  ARTICLE_RIGHT
  BLOG_INLINE
  SERVICE_SIDEBAR
}

model AdBanner {
  id          String      @id @default(cuid())
  title       String
  description String      @default("")
  imageUrl    String?
  targetUrl   String
  placement   AdPlacement @default(BLOG_SIDEBAR)
  active      Boolean     @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  impressions Int         @default(0)
  clicks      Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([placement, active])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("blog")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model BlogComment {
  id        String        @id @default(cuid())
  post      BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  name      String
  email     String
  body      String
  rating    Int?
  status    CommentStatus @default(PENDING)
  reply     String?
  repliedAt DateTime?
  ipHash    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postId, status])
  @@index([status, createdAt])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/* A one-time verification code issued to a lead's email or phone. The code is
   never stored in the clear — only an HMAC. Rows are short-lived (expiresAt)
   and single-use (consumedAt); leadId is a loose reference (no FK) so cleanup
   never cascades into leads. */
model OtpChallenge {
  id          String    @id @default(cuid())
  channel     String    // "email" | "sms"
  target      String    // the email address or phone number the code went to
  codeHash    String
  leadId      String?   // loose link — stamped verified on success
  purpose     String    @default("lead")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  resendCount Int       @default(0)
  consumedAt  DateTime?
  expiresAt   DateTime
  lastSentAt  DateTime  @default(now())
  ipHash      String?
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
  @@index([leadId])
}

/* Dynamic navigation. MenuItem rows are the DRAFT tree the admin edits;
   the public site renders the last published snapshot (SiteSetting key
   "menu:<location>:live"), so half-finished edits never leak. */
model MenuItem {
  id         String   @id @default(cuid())
  location   String   @default("HEADER")
  parentId   String?
  parent     MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   MenuItem[] @relation("MenuTree")
  label       String
  href        String  @default("#")
  icon        String?
  group       String?
  badge       String?
  description String?
  order      Int      @default(0)
  visible    Boolean  @default(true)
  /// Optional campaign window. Both null = always on (the normal case).
  /// Enforced when the live nav is read, so a window opens and closes on its
  /// own without anyone re-publishing the menu.
  visibleFrom  DateTime?
  visibleUntil DateTime?
  newTab     Boolean  @default(false)
  panelImage String?
  tagline    String?
  featured   Boolean  @default(false)
  /* Soft delete: trashed items keep their subtree and can be restored. */
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([location, parentId, order])
  @@index([location, deletedAt])
}

/* Dynamic service catalog: 7 categories, each with offers. Direct-edit
   (visible toggle gates the public site — no publish step needed here). */
model ServiceCategory {
  id         String         @id @default(cuid())
  slug       String         @unique
  name       String
  blurb      String         @default("")
  intro      String         @default("")
  icon       String?
  badge      String?
  image      String?
  stat       String?
  statLabel  String?
  priceFrom  String?
  marketNote String?
  /** Optional heading this service sits under in the contact picker. */
  group      String?
  order      Int            @default(0)
  visible    Boolean        @default(true)
  offers     ServiceOffer[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([visible, order])
}

model ServiceOffer {
  id          String          @id @default(cuid())
  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  name        String
  blurb       String          @default("")
  description String          @default("")
  features    String[]        @default([])
  priceNote   String?
  image       String?
  highlight   Boolean         @default(false)
  order       Int             @default(0)
  visible     Boolean         @default(true)

  @@index([categoryId, order])
}

/* Dynamic pricing: plans + comparison-matrix rows + one-off rate card. */
model PricingPlan {
  id             String   @id @default(cuid())
  name           String
  price          String
  quarterlyPrice String?
  // Owner-entered USD equivalents. Optional: until every visible plan has
  // one the site stays on INR, so a half-translated price table never ships.
  priceUsd       String?
  quarterlyPriceUsd String?
  period         String   @default("/mo")
  tagline        String   @default("")
  marketNote     String?
  cta            String   @default("Choose plan")
  featured       Boolean  @default(false)
  order          Int      @default(0)
  visible        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PricingRow {
  id      String  @id @default(cuid())
  label   String
  tooltip String?
  values  Json    // string per plan, aligned to visible plan order
  order   Int     @default(0)
  visible Boolean @default(true)
}

model RateCardRow {
  id         String  @id @default(cuid())
  label      String
  price      String
  priceUsd   String?
  marketNote String?
  order      Int     @default(0)
  visible    Boolean @default(true)
}

model FaqItem {
  id       String  @id @default(cuid())
  question String
  lead     String  @default("")
  rest     String  @default("")
  category String  @default("General")
  icon     String?
  featured Boolean @default(false)
  order    Int     @default(0)
  visible  Boolean @default(true)

  @@index([order])
}

enum LeadSource {
  CONTACT
  AUDIT
  ESTIMATOR
  SUTRABOT
  FORM
  WEBSITE
  SEO_AUDIT
  PPC
  LANDING
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  GOOGLE_ADS
  LINKEDIN
  REFERRAL
  ORGANIC
  EMAIL_CAMPAIGN
  COLD_CALL
  WALK_IN
  TRADE_SHOW
  MANUAL
  API
  CSV_IMPORT
}

enum LeadStatus {
  NEW
  ATTEMPTED
  CONTACTED
  VERIFIED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  FOLLOW_UP
  MEETING
  WON
  LOST
  SPAM
  DUPLICATE
  HOLD
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  whatsapp  String
  email     String?
  website   String?
  /** Optional Telegram @username for lead-facing deep-link outreach. */
  telegram  String?
  services  String[]   @default([])
  budget    String?
  timeline  String?
  message   String?
  /** Which desk the enquiry asked for: SALES | SUPPORT | GENERAL. */
  department String?
  /** Answer to "How did you find us?" — attribution, countable in admin. */
  heardFrom String?
  source    LeadSource @default(CONTACT)
  status    LeadStatus @default(NEW)
  verified  Boolean    @default(false)
  /** Channel-specific verification stamps set when a lead completes an OTP. */
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  verifiedAt    DateTime?
  /** "email" | "sms" — which channel confirmed the lead. */
  verifiedVia   String?
  notes     String?
  ipHash    String?

  // CRM fields (all optional so existing intake — contact/forms/audit/bot —
  // keeps writing leads with just the core fields).
  company         String?
  industry        String?
  country         String?
  state           String?
  city            String?
  address         String?
  campaign        String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmTerm         String?
  utmContent      String?
  /// Paid-click ids — the most reliable attribution signal there is.
  gclid           String?
  fbclid          String?
  msclkid         String?
  /// External referrer of the visit that produced this lead.
  referrer        String?
  /// Path of the first page seen. Kept even when it is not a CMS page, so
  /// /services/seo attributes as well as a landing page does.
  landingPath     String?
  /// Set only when landingPath resolves to a CMS Page, which is what makes
  /// leads-per-landing-page and conversion rate possible.
  landingPage     Page?    @relation("LeadLandingPage", fields: [landingPageId], references: [id], onDelete: SetNull)
  landingPageId   String?
  expectedRevenue Int?
  priority        LeadPriority @default(MEDIUM)
  score           Int?
  tags            String[]     @default([])
  assignedTo      User?        @relation("LeadAssignee", fields: [assignedToId], references: [id])
  assignedToId    String?
  /** Soft delete — rows are hidden, never physically removed. */
  deletedAt       DateTime?
  activities      LeadActivity[]
  followUps       FollowUp[]
  quotations      Quotation[]
  comms           CommLog[]
  attachments     Attachment[]
  payments        Payment[]
  outreachLinks   OutreachLink[]
  testimonials    Testimonial[]
  promoClaims     PromotionClaim[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([whatsapp])
  @@index([assignedToId])
  @@index([source, createdAt])
  @@index([deletedAt])
  @@index([landingPageId])
}

/* Ordered rules that route a freshly-captured lead to an owner. The first
   enabled rule whose conditions all match wins; its target pool is worked
   round-robin (rrIndex is the cursor). Empty condition lists are wildcards,
   so a rule with no conditions is a catch-all — put it last. */
model AssignmentRule {
  id         String         @id @default(cuid())
  name       String
  enabled    Boolean        @default(true)
  order      Int            @default(0)
  // Conditions: AND across categories, OR within each list, [] = any.
  sources    LeadSource[]   @default([])
  services   String[]       @default([])
  countries  String[]       @default([])
  states     String[]       @default([])
  cities     String[]       @default([])
  priorities LeadPriority[] @default([])
  keyword    String?
  // Target pool worked round-robin.
  targetUserIds String[]    @default([])
  rrIndex       Int         @default(0)
  matchCount    Int         @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([enabled, order])
}

enum FollowUpStatus {
  PENDING
  DONE
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  SUPERSEDED
  EXPIRED
}

enum CommChannel {
  EMAIL
  WHATSAPP
  SMS
  TELEGRAM
}

/* A programmatic access token for the public REST API. Only the SHA-256 of the
   key is stored (like refresh tokens); the plaintext is shown once at creation.
   `prefix` is a short non-secret label for the UI. */
model ApiKey {
  id            String    @id @default(cuid())
  name          String
  prefix        String
  keyHash       String    @unique
  scopes        String[]  @default([])
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())
}

/* An outbound webhook. On subscribed lead events we POST the payload to `url`
   with an HMAC-SHA256 signature (keyed on `secret`) so the receiver can verify
   authenticity. Last delivery result is kept for at-a-glance health. */
model Webhook {
  id              String    @id @default(cuid())
  name            String
  url             String
  events          String[]  @default([])
  secret          String
  active          Boolean   @default(true)
  lastStatus      Int?
  lastError       String?
  lastDeliveredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/* Reusable message template. `body` (and email `subject`) may contain
   {{placeholders}} — name, company, etc. — filled in at send time. */
model CommTemplate {
  id        String      @id @default(cuid())
  name      String
  channel   CommChannel
  subject   String      @default("")
  body      String
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([channel, active])
}

/* One outbound message on a lead. Email is actually sent through sendEmail and
   can be open-tracked via a 1x1 pixel keyed on `trackId`; WhatsApp is logged
   when the agent opens the pre-filled wa.me link (delivery isn't confirmable
   without the Business API). */
model CommLog {
  id         String      @id @default(cuid())
  lead       Lead?       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     String?
  channel    CommChannel
  templateId String?
  toAddress  String
  subject    String      @default("")
  body       String
  status     String      @default("SENT") // SENT | FAILED | OPENED
  openedAt   DateTime?
  trackId    String      @unique @default(cuid())
  userId     String?
  userName   String?
  createdAt  DateTime    @default(now())

  @@index([leadId, createdAt])
  @@index([channel, createdAt])
}

/* A sales quotation. Client details are snapshotted so the document stays
   correct even if the linked lead later changes. Line items + pricing knobs
   live as JSON/scalars; the money totals are recomputed and stored on every
   save so lists and the PDF never re-derive them. Revisions clone the row with
   the same `number`, an incremented `version`, and parentId set. */
model Quotation {
  id       String @id @default(cuid())
  number   String
  version  Int    @default(1)
  parentId String?

  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId String?

  clientName    String
  clientCompany String?
  clientEmail   String?
  clientPhone   String?
  clientAddress String?
  clientGstin   String?

  title    String @default("")
  notes    String @default("")
  currency String @default("INR")
  items    Json   @default("[]")

  discountPct Float  @default(0)
  taxRatePct  Float  @default(18)
  /** CGST_SGST (intra-state split) | IGST (inter-state) | NONE */
  taxMode     String @default("CGST_SGST")

  subtotal       Float @default(0)
  discountAmount Float @default(0)
  taxAmount      Float @default(0)
  total          Float @default(0)

  status     QuotationStatus @default(DRAFT)
  validUntil DateTime?

  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?

  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  attachments   Attachment[]
  payments      Payment[]

  @@unique([number, version])
  @@index([status, createdAt])
  @@index([leadId])
}

/* A file attached to a lead or a quotation. Bytes live in the same storage as
   media (Vercel Blob in prod, public/uploads in dev); this row keeps the
   original name + metadata and links it to exactly one owner. */
model Attachment {
  id           String     @id @default(cuid())
  lead         Lead?      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId       String?
  quotation    Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationId  String?
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  uploadedById   String?
  uploadedByName String?
  createdAt    DateTime   @default(now())

  @@index([leadId, createdAt])
  @@index([quotationId, createdAt])
}

/* A scheduled next-touch on a lead — a call/email/meeting reminder owned by
   one user. A cron pass reminds the owner as the due time nears and escalates
   to admins once it slips past due (each fired once via the *SentAt stamps). */
model FollowUp {
  id        String         @id @default(cuid())
  lead      Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  owner     User?          @relation("FollowUpOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId   String?
  /** call | whatsapp | email | meeting | task — mirrors activity kinds. */
  type      String         @default("task")
  title     String
  notes     String?
  dueAt     DateTime
  status    FollowUpStatus @default(PENDING)
  completedAt    DateTime?
  /** Cron bookkeeping so each notification fires exactly once. */
  reminderSentAt DateTime?
  escalatedAt    DateTime?
  createdById   String?
  createdByName String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status, dueAt])
  @@index([ownerId, status, dueAt])
  @@index([leadId, dueAt])
}

/* Immutable activity log per lead — powers the CRM timeline. Every status
   change, assignment, note and comms action appends one row. */
model LeadActivity {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  userId    String?
  userName  String?
  type      String
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model MenuVersion {
  id         String   @id @default(cuid())
  location   String
  snapshot   Json
  authorName String?
  createdAt  DateTime @default(now())

  @@index([location, createdAt])
}

/// Social proof — every row is a factual claim about a real client, so
/// nothing here is seeded with sample data. Empty tables render nothing.
model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  name      String
  /// Set when a client submitted it themselves through an outreach link,
  /// so "who said this" is answerable and it can be shown as verified.
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId    String?
  role      String   @default("")
  rating    Int      @default(5)
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, order])
  @@index([leadId])
}

/* One-time links sent to a lead. The token IS the authentication: it is long,
   random and scoped to a single lead and purpose, so the recipient never has
   to sign in to leave a review or claim an offer. Kept as rows rather than
   signed strings because the point is to know who was asked, who opened it
   and who followed through. */
enum OutreachKind {
  REVIEW
  PROMO
}

/* A social-follow offer, managed entirely from the admin.

   Honest about what it can and cannot do: there is no API on any platform
   that tells you whether someone followed you. This does NOT verify a follow
   and must not pretend to. What it buys over a public coupon code is a code
   tied to one lead, a claim you can count, and a redemption you can mark —
   which is the difference between a number and a guess. */
/// Lifecycle of a discount. Mirrors the editorial pipeline pages already use,
/// because a discount costs real margin and deserves at least as much review
/// as a blog post.
///
/// PAUSED is the state the old isActive boolean could not express: stop
/// ISSUING new codes without invalidating the ones already out there.
enum PromotionStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  LIVE
  PAUSED
  ENDED
}

model Promotion {
  id            String   @id @default(cuid())
  name          String
  /// Replaces the old isActive boolean — one source of truth, not two.
  status        PromotionStatus @default(DRAFT)
  /// Why it was sent back, paused or ended. Required on those transitions.
  statusNote    String?
  /// Author and approver are tracked so the two can be required to differ.
  /// promos.manage is Super Admin only today, so a role check alone would gate
  /// nothing — four eyes has to mean two people, not two roles.
  createdBy     User?    @relation("PromotionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdById   String?
  approvedBy    User?    @relation("PromotionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedById  String?
  approvedAt    DateTime?
  /// PERCENT | AMOUNT — kept as text so adding a type is not a migration.
  discountType  String   @default("PERCENT")
  discountValue Float    @default(10)
  currency      String   @default("INR")
  headline      String   @default("")
  body          String   @default("")
  /// Keys from the socialLinks setting; empty means every profile.
  channels      String[] @default([])
  codePrefix    String   @default("SOCIAL")
  startsAt      DateTime?
  endsAt        DateTime?
  /// null = unlimited.
  maxClaims     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  claims        PromotionClaim[]

  @@index([status])
}

model PromotionClaim {
  id          String    @id @default(cuid())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionId String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      String
  code        String    @unique
  claimedAt   DateTime  @default(now())
  /// Set when the discount is actually applied to a paying job. Was read in
  /// two places and written by nothing, which pinned every redemption figure
  /// at zero; there is now an endpoint and an admin action behind it.
  redeemedAt  DateTime?
  redeemedBy   User?    @relation("ClaimRedeemer", fields: [redeemedById], references: [id], onDelete: SetNull)
  redeemedById String?
  note        String?

  /// One code per lead per promotion — reloading the page must not mint more.
  @@unique([promotionId, leadId])
  @@index([promotionId, claimedAt])
}

model OutreachLink {
  id          String       @id @default(cuid())
  token       String       @unique
  kind        OutreachKind
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      String
  /// PROMO links point at the offer being made.
  promotionId String?
  expiresAt   DateTime?
  openedAt    DateTime?
  completedAt DateTime?
  createdById String?
  createdAt   DateTime     @default(now())

  @@index([leadId, kind])
}

model ClientLogo {
  id        String   @id @default(cuid())
  name      String
  /// Optional logo file; without one the name renders as a wordmark.
  imageUrl  String?
  websiteUrl String?
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, order])
}

model CaseStudy {
  id        String   @id @default(cuid())
  slug      String   @unique
  client    String
  title     String
  industry  String   @default("")
  /// Web | Marketing | AI — drives the /work filter tabs.
  category  String   @default("Web")
  services  String[] @default([])
  challenge String   @default("")
  solution  String   @default("")
  result    String   @default("")
  /// [{ value, label }] — shown as the metric row on the card.
  metrics   Json     @default("[]")
  timeframe String   @default("")
  image     String?
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, order])
}

/* Recorded payments against a lead or quotation.

   Deliberately a LEDGER, not a checkout: rows are entered by the team as
   money actually arrives (UPI, bank transfer, cheque, or a gateway settled
   outside the app). Live checkout is a later phase — when it lands it writes
   the same rows, so nothing here has to change. Client details are snapshot
   on the row so a payment survives its lead or quotation being deleted. */
enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
  FAILED
  CANCELLED
}

model Payment {
  id        String @id @default(cuid())
  /// Human reference, e.g. PAY-2026-0001 — unique, generated on create.
  reference String @unique

  lead        Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId      String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  quotationId String?

  clientName    String
  clientCompany String?
  clientEmail   String?
  clientPhone   String?

  amount   Float
  currency String @default("INR")
  /// upi | bank | wire | cashfree | paypal | cash | cheque | other
  method   String @default("bank")
  status   PaymentStatus @default(PENDING)

  /// UTR, cheque number or gateway transaction id.
  txnRef String?
  /// When the money actually landed (not when the row was typed).
  paidAt DateTime?
  notes  String?

  recordedById   String?
  recordedByName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([leadId])
  @@index([quotationId])
}
